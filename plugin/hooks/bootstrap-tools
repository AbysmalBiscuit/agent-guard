#!/usr/bin/env bash
# SessionStart hook: install the tools agent-guard's checks run, at the
# versions in plugin/mise.toml, through scripts/install.sh.
#
# Neither Claude Code nor Codex has an install lifecycle hook, so this runs at
# session start instead. Output goes to stderr: a SessionStart hook's stdout
# becomes model context.
#
# Every failure path exits 0: a session must start even with no network.

set -uo pipefail

[ "${AGENT_GUARD_NO_BOOTSTRAP:-}" = "1" ] && exit 0

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
MANIFEST="${PLUGIN_ROOT}/.claude-plugin/plugin.json"

warn() { printf 'agent-guard: %s\n' "$1" >&2; }

if ! command -v mise >/dev/null 2>&1; then
	warn "mise is not on PATH; install mise, then run bash ${PLUGIN_ROOT}/scripts/install.sh"
	exit 0
fi

version=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$MANIFEST" 2>/dev/null | head -1)
state_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/agent-guard"
failed="${state_dir}/bootstrap-failed"

# One attempt per plugin version, so an offline machine does not retry the
# download at every session start.
if [ "$(cat "$failed" 2>/dev/null || true)" = "${version:-unknown}" ]; then
	warn "installing the pinned tools failed previously; run bash ${PLUGIN_ROOT}/scripts/install.sh yourself, or remove ${failed} to retry"
	exit 0
fi

warn "installing pinned tools"
bash "${PLUGIN_ROOT}/scripts/install.sh" >&2
status=$?

if [ "$status" -ne 0 ]; then
	mkdir -p "$state_dir" 2>/dev/null && printf '%s\n' "${version:-unknown}" >"$failed" 2>/dev/null
	warn "install.sh exited ${status}; run bash ${PLUGIN_ROOT}/scripts/install.sh to see why"
	exit 0
fi

rm -f "$failed" 2>/dev/null
exit 0
